{
  "name": "@showcase/sdk",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./supabase": {
      "types": "./dist/supabase.d.ts",
      "import": "./dist/supabase.mjs",
      "require": "./dist/supabase.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./dist/styles.css": "./dist/styles.css",
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.mjs",
      "require": "./dist/sqlite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && pnpm build:css",
    "build:css": "postcss src/styles.css -o dist/styles.css",
    "dev": "pnpm build:css && tsup --watch",
    "dev:css": "postcss src/styles.css -o dist/styles.css --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "better-sqlite3": ">=9",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18 || ^19",
    "@types/react-dom": "^18 || ^19",
    "autoprefixer": "^10.4.0",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
