# Copy to .env at the repo root. Both hosts read this one file.
#
# Every variable below is read by code. If you add one here, make sure
# something actually consumes it — the previous version of this file listed
# five variables that nothing read (Supabase x3, Unsplash, FEED_ADAPTER),
# which sent new contributors hunting for credentials the app never wanted.

# REQUIRED — chat. Without it both hosts render, but every prompt fails.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Spotify host only. Skip these if you are running the YouTube host.
# Create an app at https://developer.spotify.com/dashboard and add the
# redirect URL there as well, or the OAuth callback is rejected.
# Playback (as opposed to browsing) additionally needs Spotify Premium.
# ─────────────────────────────────────────────────────────────────────
REACT_APP_SPOTIFY_CLIENT_ID=
REACT_APP_SPOTIFY_REDIRECT_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────

# YouTube host: path to Chrome's Cookies SQLite file. Only set this if
# Chrome is installed somewhere non-default. Unset works on stock macOS.
CHROME_COOKIE_PATH=

# NOT REQUIRED: persistence. Visitor state lives in a local SQLite file
# (.showcase/*.db, gitignored), created on first write. No database to
# provision, no credentials, no migration step.
